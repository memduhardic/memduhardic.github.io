---
layout: null
sitemap: false
---
{%- assign mapped = site.portfolio | where_exp: "p", "p.places" | sort: "date" | reverse -%}
{
  "items": [
  {%- for p in mapped %}
    {
      "title": {{ p.title | jsonify }},
      "label": {{ p.map_label | default: p.title | jsonify }},
      "summary": {{ p.excerpt | strip_html | strip | jsonify }},
      "url": {{ p.url | relative_url | jsonify }},
      "places": {{ p.places | jsonify }}
    }{% unless forloop.last %},{% endunless %}
  {%- endfor %}
  ]
}
